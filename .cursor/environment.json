{
  "name": "ELVA SocialAI",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "web",
      "command": "cd /workspace && source .venv/bin/activate && exec gunicorn main:app --bind 0.0.0.0:5000 --workers 2 --timeout 120 --access-logfile - --error-logfile -"
    }
  ],
  "ports": [5000]
}
